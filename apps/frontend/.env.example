# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno del frontend (Vite).
#
# Para Dokploy:
# En el despliegue del Frontend en Dokploy, declarar VITE_API_URL como Build Argument
# o Variable de Entorno con la URL pública HTTPS del backend (sin barra final).
# ─────────────────────────────────────────────────────────────────────────────

VITE_API_URL=http://localhost:3000
